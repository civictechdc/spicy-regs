    {
      "id": "provider-output-file-layout",
      "kind": "run_file_layout",
      "old": "The predecessor stored provider output beside each experiment.",
      "new": "The v3 pipeline stores provider output below one retrieval directory.",
      "reason": "The v3 run directory groups immutable provider output by pipeline stage.",
      "proof": {
        "old_files": [
          "embedding_cache.parquet",
          "rerank_requests.parquet",
          "reranked_candidates.parquet",
          "sparse_embeddings.parquet"
        ],
        "new_files": [
          "retrieval/dense-embeddings.parquet",
          "retrieval/rerank-scores.parquet",
          "retrieval/sparse-embeddings.parquet"
        ]
      }
    },
    {
      "id": "rerank-row-layout",
      "kind": "row_layout",
      "old": "The predecessor split one request from its candidate rows.",
      "new": "The v3 pipeline stores one typed immutable score row per candidate.",
      "reason": "Each v3 row keeps the provider input, result, and provenance together.",
